# Configuración general de la aplicación
PROJECT_ID=safari-zone-selectra
PORT=8080
APP_NAME=comfey

# Modo de desarrollo local (en Cloud Run IAP se encarga de la identidad)
DEV_MODE=true
DEV_USER_EMAIL=carlos.alfageme@selectra.com
DEV_USER_ROLE=admin

# Persistencia de Datos en Google Cloud (Principio Universal Zero-Key con ADC)
GCS_BUCKET_NAME=safari-zone-comfey-data
FIRESTORE_DATABASE_ID=comfey

# Integración Nexus - Query API - Assets (Microservicio Cloud Run)
# URL base del microservicio en Cloud Run / Safari Zone
NEXUS_QUERY_API_ASSETS_URL=https://nexus-query-api-assets-xxxxx-ew.a.run.app
# API Key opcional (si se accede a través del Gateway de Nexus en lugar de Google IAM ADC)
NEXUS_API_KEY=
