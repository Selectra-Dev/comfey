# Configuración general de la aplicación
PROJECT_ID=safari-zone-selectra
PORT=8080
APP_NAME=comfey

# Persistencia de Datos en Google Cloud (Principio Universal Zero-Key con ADC)
GCS_BUCKET_NAME=safari-zone-comfey-data
FIRESTORE_DATABASE_ID=comfey

# Variables exclusivas de desarrollo local (comentadas para producción en Cloud Run)
# En producción, Google Cloud IAP se encarga de la identidad corporativa.
# DEV_MODE=true
# DEV_USER_EMAIL=carlos.alfageme@selectra.com
# DEV_USER_ROLE=admin

# Integración Nexus - Query API - Assets (Principio Universal Zero-Key con IAM OIDC)
# Las invocaciones entre microservicios Cloud Run se autentican mediante OIDC Tokens.
# No requiere API Keys ni secretos en Secret Manager.
# NEXUS_QUERY_API_ASSETS_URL=https://nexus-query-api-assets-xxxxx-ew.a.run.app
